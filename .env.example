PROJECT_NAME="Fortune Trading QUAD"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:3003"

POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quad_trading

REDIS_HOST=redis
REDIS_PORT=6379

# Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_KEY_PEPPER=your_64_character_pepper_here_replace_with_actual_secure_random_value
SESSION_EXPIRY_TIME=03:00

# Angel One Broker Integration (Optional - for direct Angel One connectivity)
# Get these from https://smartapi.angelbroking.com/
ANGELONE_API_KEY=your_angel_one_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_password_here
ANGELONE_TOTP_SECRET=your_totp_secret_here

# Broker Selection (openalgo or angelone)
BROKER_TYPE=openalgo
